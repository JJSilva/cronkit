# cronkit — one daemon, many tools.
#
# Daemon-level settings are prefixed CRONKIT_. Each tool namespaces its own
# settings under its own prefix, so tools can never collide.

# Daemon --------------------------------------------------------------------
# Shared secret guarding every endpoint except /health. A Railway service is
# reachable from the public internet, so without this those endpoints refuse
# every request. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRONKIT_API_TOKEN=

# Which tools to load. Blank means every registered tool.
# CRONKIT_TOOLS=trainingpeaks-calendar

# Set false to wait out the first interval instead of running at startup.
# CRONKIT_RUN_ON_START=true


# Tool: trainingpeaks-calendar ----------------------------------------------
# Sync timed TrainingPeaks workouts into Google Calendar.

# The Production_tpAuth cookie value from a logged-in TrainingPeaks session.
# This is the same credential the trainingpeaks-mcp deployment uses.
# It expires periodically and must be refreshed by hand — see README.
TP_CALENDAR_AUTH_COOKIE=

# From a "Desktop app" OAuth client, plus the refresh token printed by
# scripts/google_oauth_setup.py.
TP_CALENDAR_GOOGLE_CLIENT_ID=
TP_CALENDAR_GOOGLE_CLIENT_SECRET=
TP_CALENDAR_GOOGLE_REFRESH_TOKEN=

# Calendar to write workouts to.
TP_CALENDAR_GOOGLE_CALENDAR_ID=you@gmail.com

# How often the tool re-syncs, in minutes. Set both bounds to draw each wait
# randomly from that range instead of running on an exact schedule; set them
# equal (or use TP_CALENDAR_INTERVAL_MINUTES alone) for a fixed interval.
TP_CALENDAR_INTERVAL_MIN_MINUTES=5
TP_CALENDAR_INTERVAL_MAX_MINUTES=15

# How many days ahead of today to sync.
TP_CALENDAR_DAYS=21

# IANA timezone for TrainingPeaks' planned start times.
# Leave blank to use the target calendar's own timezone.
TP_CALENDAR_TIMEZONE=

# Set to false to keep events whose workout lost its planned time or was deleted.
TP_CALENDAR_PRUNE=true

# Set to false to keep the tool loaded but never scheduled.
# TP_CALENDAR_ENABLED=true


# Deprecated aliases ---------------------------------------------------------
# The pre-cronkit names are still accepted, so a deployment that predates the
# rename keeps working untouched. The namespaced name wins when both are set.
#
#   TP_AUTH_COOKIE            -> TP_CALENDAR_AUTH_COOKIE
#   GOOGLE_CLIENT_ID          -> TP_CALENDAR_GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET      -> TP_CALENDAR_GOOGLE_CLIENT_SECRET
#   GOOGLE_REFRESH_TOKEN      -> TP_CALENDAR_GOOGLE_REFRESH_TOKEN
#   CALENDAR_ID               -> TP_CALENDAR_GOOGLE_CALENDAR_ID
#   SYNC_DAYS                 -> TP_CALENDAR_DAYS
#   SYNC_TIMEZONE             -> TP_CALENDAR_TIMEZONE
#   SYNC_PRUNE                -> TP_CALENDAR_PRUNE
#   SYNC_INTERVAL_*_MINUTES   -> TP_CALENDAR_INTERVAL_*_MINUTES
#   SYNC_API_TOKEN            -> CRONKIT_API_TOKEN
