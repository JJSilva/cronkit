# TrainingPeaks -------------------------------------------------------------
# The Production_tpAuth cookie value from a logged-in TrainingPeaks session.
# This is the same credential the trainingpeaks-mcp deployment uses.
# It expires periodically and must be refreshed by hand — see README.
TP_AUTH_COOKIE=

# Google Calendar -----------------------------------------------------------
# From a "Desktop app" OAuth client, plus the refresh token printed by
# scripts/google_oauth_setup.py.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Calendar to write workouts to.
CALENDAR_ID=you@gmail.com

# Service auth --------------------------------------------------------------
# Shared secret guarding /status and /sync. A Railway service is reachable
# from the public internet, so without this those endpoints refuse every
# request. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_TOKEN=

# Behaviour -----------------------------------------------------------------
# How many days ahead of today to sync.
SYNC_DAYS=21
# How often the service re-syncs, in minutes.
SYNC_INTERVAL_MINUTES=60
# IANA timezone for TrainingPeaks' planned start times.
# Leave blank to use the target calendar's own timezone.
SYNC_TIMEZONE=
# Set to false to keep events whose workout lost its planned time or was deleted.
SYNC_PRUNE=true
